# Sofía Smith — Hermes Agent WhatsApp environment + NVIDIA NIM brain
# Keep all live values in the deployment secret store. Never commit real keys.

# Hermes is the mandatory operating environment for Sofía on WhatsApp.
SOFIA_WHATSAPP_ENVIRONMENT=hermes
SOFIA_HERMES_VERSION=0.21.0

# Primary inference inside the Hermes environment.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SOFIA_NVIDIA_MODEL=openai/gpt-oss-120b

# Existing OpenAI key remains an inference fallback only.
OPENAI_API_KEY=
SOFIA_WHATSAPP_MODEL=gpt-5.6-sol
