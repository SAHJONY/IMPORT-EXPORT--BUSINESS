# Core production mode
PRODUCTION_MODE=true
OWNER_TOKEN=replace-with-a-long-random-owner-token
EMPLOYEE_TOKEN=replace-with-a-long-random-employee-token
OWNER_MFA_REQUIRED=true
AUTH_PROVIDER=insforge

# InsForge production backend
INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=ik_replace_with_project_admin_key
INSFORGE_ANON_KEY=anon_replace_with_public_key
INSFORGE_STORAGE_ENABLED=true

# Worldwide language / translation
# Azure Translator credentials stay server-side. If absent, original text remains canonical and translation fails closed.
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
DEFAULT_LOCALE=en-US
TRANSLATION_LEGAL_HUMAN_REVIEW_REQUIRED=true
# Public page-label translation is separately gated and rate limited; participant/business content still requires role authentication.
PUBLIC_UI_TRANSLATION_ENABLED=false
PUBLIC_UI_TRANSLATION_RPM=20

# Government / trade intelligence connectors
# OFAC SDN + non-SDN are connected directly from Treasury SLS.
# USITC HTS REST is connected directly for U.S. import tariff/classification research.
TRADE_GOV_API_KEY=
# Census now requires an API key for live international-trade queries.
CENSUS_TRADE_API_KEY=

# Maersk production tracking integration
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
MAERSK_TOKEN_URL=
MAERSK_API_BASE=
MAERSK_HEALTH_PATH=
# Contracted provider path. Must include {tracking_reference}; do not guess this endpoint.
MAERSK_TRACKING_PATH_TEMPLATE=
LOGISTICS_DATA_PROVIDER=maersk

# FX / settlement
# Recommended first integration: Airwallex. Account approval/KYC and production keys are external gates.
FX_EXECUTION_PROVIDER=airwallex
AIRWALLEX_API_BASE=https://api.airwallex.com/api/v1
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_LOGIN_AS=
# Generic fallback adapter if another provider is selected.
FX_EXECUTION_API_BASE=
FX_EXECUTION_API_KEY=
FX_EXECUTION_HEALTH_PATH=

# Governance / operations
AUDIT_RETENTION_DAYS=365
BACKUPS_ENABLED=true
VERCEL_MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
E2E_TRADE_WORKFLOW_VERIFIED=false
