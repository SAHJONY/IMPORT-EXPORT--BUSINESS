# Core production mode
PRODUCTION_MODE=true
OWNER_TOKEN=replace-with-a-long-random-owner-token
OWNER_MFA_REQUIRED=true
AUTH_PROVIDER=insforge

# InsForge production backend
INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=ik_replace_with_project_admin_key
INSFORGE_ANON_KEY=anon_replace_with_public_key
INSFORGE_STORAGE_ENABLED=true

# Government / trade intelligence connectors
# Trade.gov CSL is preferred for consolidated restricted-party screening.
TRADE_GOV_API_KEY=replace-with-trade-gov-key
# Optional direct Treasury OFAC data path; keep fail-closed if not verified.
OFAC_DIRECT_SCREENING=false
TARIFF_DATA_PROVIDER=replace-with-authoritative-tariff-provider
LOGISTICS_DATA_PROVIDER=replace-with-live-logistics-provider
FX_DATA_PROVIDER=replace-with-authoritative-fx-provider

# Governance / operations
AUDIT_RETENTION_DAYS=365
BACKUPS_ENABLED=true
VERCEL_MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
# Set true only after a recorded production-safe E2E trade workflow passes.
E2E_TRADE_WORKFLOW_VERIFIED=false
