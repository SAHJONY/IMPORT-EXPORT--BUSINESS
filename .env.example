# Core production mode
PRODUCTION_MODE=true
OWNER_TOKEN=replace-with-a-long-random-owner-token
OWNER_MFA_REQUIRED=true
AUTH_PROVIDER=insforge

# InsForge production backend
INSFORGE_BASE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=ik_replace_with_project_admin_key
INSFORGE_ANON_KEY=anon_replace_with_public_key
INSFORGE_STORAGE_ENABLED=true

# Government / trade intelligence connectors
# OFAC SDN + non-SDN data are connected directly from Treasury SLS; no key required.
# USITC HTS REST is connected directly for U.S. import classification/tariff research.
# Optional Trade.gov key enables authenticated CSL/FTA tariff API capabilities.
TRADE_GOV_API_KEY=

# Maersk production tracking integration
# Create/approve the API product in Maersk Developer Portal, then set these server-only values.
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
MAERSK_TOKEN_URL=
MAERSK_API_BASE=
# Safe GET path that validates the approved tracking product/customer scope.
MAERSK_HEALTH_PATH=
LOGISTICS_DATA_PROVIDER=maersk

# FX
# ECB/Federal Reserve reference FX feeds are public and already connected for planning.
# Executable/settlement FX requires a KYC-approved provider account/API.
FX_EXECUTION_PROVIDER=
FX_EXECUTION_API_BASE=
FX_EXECUTION_API_KEY=
FX_EXECUTION_HEALTH_PATH=

# Governance / operations
AUDIT_RETENTION_DAYS=365
BACKUPS_ENABLED=true
VERCEL_MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
# Set true only after a recorded production-safe E2E trade workflow passes.
E2E_TRADE_WORKFLOW_VERIFIED=false
