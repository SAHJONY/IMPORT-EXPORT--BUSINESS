# Core production mode
PRODUCTION_MODE=true
OWNER_TOKEN=replace-with-a-long-random-owner-token
EMPLOYEE_TOKEN=replace-with-a-long-random-employee-token
OWNER_MFA_REQUIRED=true
# Base32 TOTP secret. Configure only in the production secret manager; never commit a real value.
OWNER_TOTP_SECRET=
AUTH_PROVIDER=neon_auth
ALLOW_LEGACY_LOCAL_AUTH=false

# Neon Auth identity layer
NEON_AUTH_URL=https://ep-empty-shadow-ayfporoz.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-empty-shadow-ayfporoz.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://ep-empty-shadow-ayfporoz.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth
NEON_EMPLOYEE_EMAILS=

# Durable trade persistence (preferred: Neon/Postgres attached to Vercel)
# Any one supported Postgres URL is sufficient. Vercel/Neon integrations normally inject DATABASE_URL or POSTGRES_URL.
DATABASE_URL=
POSTGRES_URL=
NEON_DATABASE_URL=
PERSISTENCE_ISOLATION_VERIFIED=false
PERSISTENCE_SCHEMA_VERIFIED=false

# Optional InsForge-compatible persistence fallback
INSFORGE_BASE_URL=
INSFORGE_API_KEY=
INSFORGE_ANON_KEY=
INSFORGE_RLS_VERIFIED=false
INSFORGE_SCHEMAS_APPLIED=false

# Business E2E verification gates
COUNTRY_ACTIVATION_E2E_VERIFIED=false
GLOBAL_SUPPLIER_SOURCING_E2E_VERIFIED=false
MANAGED_TRADE_GATEWAY_E2E_VERIFIED=false
INTERMEDIARY_MODE_E2E_VERIFIED=false
BUSINESS_OPERATIONAL_READINESS_E2E_VERIFIED=false
CUBA_PRIVATE_BUSINESS_E2E_VERIFIED=false
CUBA_AUTHORIZED_TRADE_E2E_VERIFIED=false
FIRST_LIVE_TRADE_CERTIFIED=false

# Multi-model AI brain
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-terra
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_FRONTIER_MODEL=claude-fable-5
ANTHROPIC_PRIMARY_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5
AI_BRAIN_E2E_VERIFIED=false

# Private S3-compatible document storage
INSFORGE_STORAGE_ENABLED=true
INSFORGE_S3_ENDPOINT=
INSFORGE_S3_REGION=us-east-2
INSFORGE_S3_ACCESS_KEY_ID=
INSFORGE_S3_SECRET_ACCESS_KEY=
INSFORGE_STORAGE_BUCKET=trade-documents
SIGNED_DOCUMENT_STORAGE_VERIFIED=false
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_UPLOAD_URL_TTL_SECONDS=600
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_CALLBACK_SECRET=

# Worldwide language / translation
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
DEFAULT_LOCALE=en-US
TRANSLATION_LEGAL_HUMAN_REVIEW_REQUIRED=true
PUBLIC_UI_TRANSLATION_ENABLED=false
PUBLIC_UI_TRANSLATION_RPM=20
MULTILINGUAL_E2E_VERIFIED=false

# Government / trade intelligence connectors
TRADE_GOV_API_KEY=
CENSUS_TRADE_API_KEY=

# Maersk production tracking integration
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
MAERSK_TOKEN_URL=
MAERSK_API_BASE=
MAERSK_HEALTH_PATH=
MAERSK_TRACKING_PATH_TEMPLATE=
LOGISTICS_DATA_PROVIDER=maersk
CARRIER_E2E_VERIFIED=false

# FX / settlement
FX_EXECUTION_PROVIDER=airwallex
AIRWALLEX_API_BASE=https://api.airwallex.com/api/v1
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_LOGIN_AS=
FX_EXECUTION_API_BASE=
FX_EXECUTION_API_KEY=
FX_EXECUTION_HEALTH_PATH=

# Finance / accounting verification
ACCOUNTING_LEDGER_VERIFIED=false
PAYMENT_RECONCILIATION_VERIFIED=false
BENEFICIARY_MAKER_CHECKER_VERIFIED=false

# Governed sharing / collaboration verification
COLLABORATION_E2E_VERIFIED=false

# Governance / operations
AUDIT_RETENTION_DAYS=365
BACKUPS_ENABLED=true
BACKUP_RESTORE_TESTED=false
VERCEL_MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
E2E_TRADE_WORKFLOW_VERIFIED=false
