# SAHJONY LLC · GLOBAL TRADE OS
# Canonical production platform: Supabase Database + Auth + Storage
PRODUCTION_MODE=true
AUTH_PROVIDER=supabase_auth
ALLOW_LEGACY_LOCAL_AUTH=false

# Supabase canonical backend / identity / storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase secret key can be used instead of the legacy service-role key.
SUPABASE_SECRET_KEY=
# Browser-safe values only. NEVER expose SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY to VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=trade-documents

# Optional direct PostgreSQL connection to the SAME Supabase project for SQL-only modules.
# Use the Supabase transaction/session pooler in Vercel when direct database access is required.
DATABASE_URL=
POSTGRES_URL=
PERSISTENCE_ISOLATION_VERIFIED=false
PERSISTENCE_SCHEMA_VERIFIED=false

# Owner security. Owner identity is verified by Supabase Auth and must also have an active owner membership.
OWNER_EMAIL=sahjonycapitalllc@outlook.com
OWNER_SESSION_SECRET=
OWNER_MFA_REQUIRED=true
OWNER_TOTP_SECRET=
EMPLOYEE_TOKEN=

# Higgsfield Cloud deployment: credentials remain server-side in Vercel.
# Private Higgsfield responses enforce no-store/no-cache at runtime.
# Higgsfield Cloud cinematic generation. Server-side only; never use VITE_* names.
HF_API_KEY=
HF_API_SECRET=
# Override only if Higgsfield Cloud shows a different application endpoint for Seedance 2.5.
HF_SEEDANCE_APPLICATION=seedance_2_5

# Business E2E verification gates
COUNTRY_ACTIVATION_E2E_VERIFIED=false
GLOBAL_SUPPLIER_SOURCING_E2E_VERIFIED=false
MANAGED_TRADE_GATEWAY_E2E_VERIFIED=false
INTERMEDIARY_MODE_E2E_VERIFIED=false
BUSINESS_OPERATIONAL_READINESS_E2E_VERIFIED=false
CUBA_PRIVATE_BUSINESS_E2E_VERIFIED=false
CUBA_AUTHORIZED_TRADE_E2E_VERIFIED=false
FIRST_LIVE_TRADE_CERTIFIED=false

# Multi-model AI brain + exclusive OpenAI realtime voice
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_PRIMARY_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.6-terra
OPENAI_ECONOMY_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
DIRECT_WEBRTC_VOICE_ENABLED=true

# NVIDIA NIM hosted inference + autonomous OpenClaw failover pool
# Key source: build.nvidia.com/settings/api-keys. Keep server-side only.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_PRIMARY_FALLBACK=nvidia/nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_ROTATION_MODE=live_inventory_plus_runtime_failover
NVIDIA_NIM_ROTATION_INTERVAL_MINUTES=10
NVIDIA_NIM_FALLBACK_ENABLED=true
NVIDIA_NIM_E2E_VERIFIED=false

ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_FRONTIER_MODEL=claude-fable-5
ANTHROPIC_PRIMARY_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5
AI_BRAIN_E2E_VERIFIED=false

# T-Mobile DevEdge Bring Your Own Number (BYON) adapter
TMOBILE_BYON_CLIENT_ID=
TMOBILE_BYON_CLIENT_SECRET=
TMOBILE_BYON_REDIRECT_URI=https://www.sahjony.com/voice/byon/callback
TMOBILE_BYON_API_BASE=https://naas.t-mobile.com/cpaas
TMOBILE_BYON_E2E_VERIFIED=false

# Legacy Bland transport only
BLAND_API_KEY=
BLAND_OUTBOUND_NUMBER=
BLAND_INBOUND_NUMBER=
BLAND_WEBHOOK_SECRET=
VOICE_SIP_BRIDGE_URL=
VOICE_SIP_BRIDGE_TOKEN=
VOICE_SIP_BRIDGE_E2E_VERIFIED=false
VOICE_AGENT_E2E_VERIFIED=false

# Supabase document storage governance
SIGNED_DOCUMENT_STORAGE_VERIFIED=false
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_UPLOAD_URL_TTL_SECONDS=600
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=300
DOCUMENT_MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_CALLBACK_SECRET=

# Worldwide language / translation
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
