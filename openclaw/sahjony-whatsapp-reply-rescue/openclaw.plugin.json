{
  "id": "sahjony-whatsapp-reply-rescue",
  "name": "SAHJONY WhatsApp Reply Rescue",
  "description": "Fail-safe reply generation for successful WhatsApp turns that produce no visible reply payload.",
  "version": "1.0.0",
  "capabilities": {
    "promptInjection": true,
    "conversationAccess": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accountId": { "type": "string" },
      "businessNumber": { "type": "string" },
      "rescueDelayMs": { "type": "number" }
    }
  }
}
