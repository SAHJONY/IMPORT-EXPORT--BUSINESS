{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "communication_api.py", "use": "@vercel/python" },
    { "src": "document_api.py", "use": "@vercel/python" },
    { "src": "document_storage_api.py", "use": "@vercel/python" },
    { "src": "shipment_api.py", "use": "@vercel/python" },
    { "src": "compliance_api.py", "use": "@vercel/python" },
    { "src": "commercial_api.py", "use": "@vercel/python" },
    { "src": "translation_api.py", "use": "@vercel/python" },
    { "src": "collaboration_api.py", "use": "@vercel/python" },
    { "src": "finance_api.py", "use": "@vercel/python" },
    { "src": "country_activation_api.py", "use": "@vercel/python" },
    { "src": "cuba_current_api.py", "use": "@vercel/python" },
    { "src": "cuba_transition_api.py", "use": "@vercel/python" },
    { "src": "cuba_trade_desk_api.py", "use": "@vercel/python" },
    { "src": "cuba_private_business_api.py", "use": "@vercel/python" },
    { "src": "fastapi_server.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/communications/(.*)", "dest": "communication_api.py" },
    { "src": "/document-storage(.*)", "dest": "document_storage_api.py" },
    { "src": "/documents(.*)", "dest": "document_api.py" },
    { "src": "/shipments(.*)", "dest": "shipment_api.py" },
    { "src": "/compliance(.*)", "dest": "compliance_api.py" },
    { "src": "/commercial(.*)", "dest": "commercial_api.py" },
    { "src": "/language(.*)", "dest": "translation_api.py" },
    { "src": "/collaboration(.*)", "dest": "collaboration_api.py" },
    { "src": "/finance(.*)", "dest": "finance_api.py" },
    { "src": "/cuba-private(.*)", "dest": "cuba_private_business_api.py" },
    { "src": "/cuba-desk(.*)", "dest": "cuba_trade_desk_api.py" },
    { "src": "/cuba-transition(.*)", "dest": "cuba_transition_api.py" },
    { "src": "/cuba(.*)", "dest": "cuba_current_api.py" },
    { "src": "/countries(.*)", "dest": "country_activation_api.py" },
    { "src": "/health", "dest": "fastapi_server.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
