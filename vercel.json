{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "unified_api.py", "use": "@vercel/python" },
    { "src": "whatsapp_api.py", "use": "@vercel/python" },
    { "src": "ui_language_api.py", "use": "@vercel/python" },
