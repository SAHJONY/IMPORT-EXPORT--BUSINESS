    { "src": "/individual-consumer-card", "dest": "/consumer-card.html" },
    { "src": "/cuba-consumer-card", "dest": "/consumer-card.html" },
    { "src": "/cuba-consumers", "dest": "/cuba-individual-consumers.html" },
    { "src": "/individual-consumers", "dest": "/cuba-individual-consumers.html" },
    { "src": "/cuba-individual-consumers", "dest": "/cuba-individual-consumers.html" },
    { "src": "/cuba-partners", "dest": "/cuba-partners.html" },
    { "src": "/partners/cuba", "dest": "/cuba-partners.html" },
    { "src": "/owner-login", "dest": "/owner-login.html" },
    { "src": "/owner/email", "dest": "/owner-email-command.html" },
    { "src": "/owner/email-command", "dest": "/owner-email-command.html" },
