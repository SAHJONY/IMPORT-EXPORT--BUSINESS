{
  "version": 2,
  "builds": [
    { "src": "access_portal.py", "use": "@vercel/python" },
    { "src": "fastapi_server.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/owner/?$", "dest": "access_portal.py" },
    { "src": "/employee/?$", "dest": "access_portal.py" },
    { "src": "/customer/?$", "dest": "access_portal.py" },
    { "src": "/login/(.*)", "dest": "access_portal.py" },
    { "src": "/auth/(.*)", "dest": "access_portal.py" },
    { "src": "/dashboard/?$", "status": 308, "headers": { "Location": "/owner" } },
    { "src": "/client/?$", "status": 308, "headers": { "Location": "/customer" } },
    { "src": "/portal/?$", "status": 308, "headers": { "Location": "/customer" } },
    { "src": "/$", "status": 308, "headers": { "Location": "/employee" } },
    { "src": "/(.*)", "dest": "fastapi_server.py" }
  ]
}
