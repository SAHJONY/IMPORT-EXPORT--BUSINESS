{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "unified_api.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/communications/(.*)", "dest": "unified_api.py" },
    { "src": "/document-storage(.*)", "dest": "unified_api.py" },
    { "src": "/documents(.*)", "dest": "unified_api.py" },
    { "src": "/shipments(.*)", "dest": "unified_api.py" },
    { "src": "/compliance(.*)", "dest": "unified_api.py" },
    { "src": "/commercial(.*)", "dest": "unified_api.py" },
    { "src": "/language(.*)", "dest": "unified_api.py" },
    { "src": "/collaboration(.*)", "dest": "unified_api.py" },
    { "src": "/finance(.*)", "dest": "unified_api.py" },
    { "src": "/business-readiness(.*)", "dest": "unified_api.py" },
    { "src": "/global-sourcing(.*)", "dest": "unified_api.py" },
    { "src": "/intermediary(.*)", "dest": "unified_api.py" },
    { "src": "/managed-trade(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-private(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-desk(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-transition(.*)", "dest": "unified_api.py" },
    { "src": "/cuba(.*)", "dest": "unified_api.py" },
    { "src": "/countries(.*)", "dest": "unified_api.py" },
    { "src": "/health", "dest": "unified_api.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
