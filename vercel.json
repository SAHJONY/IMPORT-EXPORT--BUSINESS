{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "unified_api.py", "use": "@vercel/python" },
    { "src": "cuba_language_api.py", "use": "@vercel/python" },
    { "src": "cuba_energy_desk_api.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/", "dest": "/landing.html" },
    { "src": "/business", "dest": "/landing.html" },
    { "src": "/start", "dest": "/start.html" },
    { "src": "/lead-scout", "dest": "/lead-scout.html" },
    { "src": "/scout", "dest": "/lead-scout.html" },
    { "src": "/us-desk-card", "dest": "/cuba-us-desk-card.html" },
    { "src": "/cuba-us-desk-card", "dest": "/cuba-us-desk-card.html" },
    { "src": "/owner-login", "dest": "/owner-login.html" },
    { "src": "/owner/telegram", "dest": "/owner-telegram.html" },
    { "src": "/owner/crm-countries", "dest": "/owner-crm-countries.html" },
    { "src": "/owner/lead-search", "dest": "/owner-lead-search.html" },
    { "src": "/owner/energy", "dest": "/owner-energy-hub.html" },
    { "src": "/owner/energy-hub", "dest": "/owner-energy-hub.html" },
    { "src": "/owner/energy/crude-oil", "dest": "/owner-energy-crude.html" },
    { "src": "/owner/energy/origination", "dest": "/owner-energy-origination.html" },
    { "src": "/owner/energy/intelligence", "dest": "/owner-energy-intelligence.html" },
    { "src": "/owner/energy/providers", "dest": "/owner-energy-providers.html" },
    { "src": "/owner/energy/compliance", "dest": "/owner-energy-compliance.html" },
    { "src": "/owner/energy/deal-flow", "dest": "/owner-energy-deal-flow.html" },
    { "src": "/owner/energy/revenue", "dest": "/owner-energy-revenue.html" },
    { "src": "/owner/energy/operations", "dest": "/owner-energy-operations.html" },
    { "src": "/owner/energy/closing", "dest": "/owner-energy-closing.html" },
    { "src": "/owner/cuba-energy", "dest": "/owner-cuba-energy.html" },
    { "src": "/owner/cuba/energy", "dest": "/owner-cuba-energy.html" },
    { "src": "/owner/energy/cuba", "dest": "/owner-cuba-energy.html" },
    { "src": "/owner/cuba-fuels", "dest": "/owner-cuba-fuels.html" },
    { "src": "/owner/cuba/fuels", "dest": "/owner-cuba-fuels.html" },
    { "src": "/owner/energy/cuba-fuels", "dest": "/owner-cuba-fuels.html" },
    { "src": "/owner/cuba-us-desk", "dest": "/cuba-us-desk.html" },
    { "src": "/cuba-private-sector", "dest": "/cuba-es.html" },

    { "src": "/cuba-energy(.*)", "dest": "cuba_energy_desk_api.py" },
    { "src": "/cuba-language(.*)", "dest": "cuba_language_api.py" },
    { "src": "/lead-scout/(health|leads.*)", "dest": "unified_api.py" },
    { "src": "/lead-search(.*)", "dest": "unified_api.py" },
    { "src": "/energy(.*)", "dest": "unified_api.py" },
    { "src": "/activation(.*)", "dest": "unified_api.py" },
    { "src": "/backend(.*)", "dest": "unified_api.py" },
    { "src": "/identity(.*)", "dest": "unified_api.py" },
    { "src": "/telegram(.*)", "dest": "unified_api.py" },
    { "src": "/business-email(.*)", "dest": "unified_api.py" },
    { "src": "/email-agent(.*)", "dest": "unified_api.py" },
    { "src": "/owner-auth(.*)", "dest": "unified_api.py" },
    { "src": "/crm(.*)", "dest": "unified_api.py" },
    { "src": "/country-crm(.*)", "dest": "unified_api.py" },
    { "src": "/trade-agent(.*)", "dest": "unified_api.py" },
    { "src": "/trade-certification(.*)", "dest": "unified_api.py" },
    { "src": "/communications/(.*)", "dest": "unified_api.py" },
    { "src": "/document-storage(.*)", "dest": "unified_api.py" },
    { "src": "/documents(.*)", "dest": "unified_api.py" },
    { "src": "/shipments(.*)", "dest": "unified_api.py" },
    { "src": "/compliance(.*)", "dest": "unified_api.py" },
    { "src": "/commercial(.*)", "dest": "unified_api.py" },
    { "src": "/language(.*)", "dest": "unified_api.py" },
    { "src": "/collaboration(.*)", "dest": "unified_api.py" },
    { "src": "/finance(.*)", "dest": "unified_api.py" },
    { "src": "/business-readiness(.*)", "dest": "unified_api.py" },
    { "src": "/global-sourcing(.*)", "dest": "unified_api.py" },
    { "src": "/intermediary(.*)", "dest": "unified_api.py" },
    { "src": "/managed-trade(.*)", "dest": "unified_api.py" },
    { "src": "/us-import(.*)", "dest": "unified_api.py" },
    { "src": "/ai-brain(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-private-sector/(health|leads.*)", "dest": "unified_api.py" },
    { "src": "/cuba-private(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-desk(.*)", "dest": "unified_api.py" },
    { "src": "/cuba-transition(.*)", "dest": "unified_api.py" },
    { "src": "/cuba(.*)", "dest": "unified_api.py" },
    { "src": "/countries(.*)", "dest": "unified_api.py" },
    { "src": "/health", "dest": "unified_api.py" },

    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
